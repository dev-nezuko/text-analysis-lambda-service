FLASK_APP=app
# Versioned spaCy model archive stored at s3://$S3_BUCKET/models/<name>.tar.gz,
# or blank:en for a tokenizer-only pipeline that needs no download (finds no entities).
SPACY_MODEL_MEDIUM=en_core_web_md-3.8.0
# Model used by `python -m src.manage_models --download/--upload`
SPACY_MODEL_SMALL=en_core_web_sm-3.8.0
S3_BUCKET=
# Optional: exact SHA-256 of the trusted model tar.gz archive
SPACY_MODEL_SHA256=
# Optional error reporting; request text may be sensitive
SENTRY_DSN=
