{
    "dev": {
        "app_function": "app.app",
        "aws_region": "your-aws-region",
        "profile_name": "default",
        "project_name": "text-analysis-service",
        "runtime": "python3.8",
        "s3_bucket": "your-zappa-deployments-bucket",
        "slim_handler": true,
        "keep_warm": true,
        "memory_size": 1408,
        "lambda_concurrency": 100,
        "exclude": [
            "__pycache__",
            ".pytest_cache",
            ".vscode",
            "*.pyc",
            "test/*"
        ]
    }
}
